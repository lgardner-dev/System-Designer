+}
+#[test]
+fn focused_frames_keep_the_full_scope_export() {
+    let ctx = egui::Context::default();
+    let mut a = app(cases()[0].0);
+    let before = serde_json::to_value(
+        exchange::export(a.store.project(), "root", Scope::Level, None).expect("export"),
